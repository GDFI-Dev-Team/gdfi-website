{
  "name": "src",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bundle-content": "node scripts/bundle-content.mjs",
    "dev": "node scripts/bundle-content.mjs && next dev",
    "build": "node scripts/bundle-content.mjs && next build",
    "preview": "node scripts/bundle-content.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/bundle-content.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "node scripts/bundle-content.mjs && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.4",
    "react-date-picker": "^12.0.2",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.105.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
